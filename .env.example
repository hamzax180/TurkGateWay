# ── Database ────────────────────────────────────────────────────────────────
# Neon / Supabase PostgreSQL connection string (pgvector extension required)
DATABASE_URL=

# ── Qwen via Alibaba DashScope ──────────────────────────────────────────────
# All client-facing replies are generated here. https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=
# Mainland China accounts use https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# qwen3.8-max measured best for Turkmen (fewest Turkish leaks, lowest latency).
# NOTE: bare "qwen-max"/"qwen-plus" are LEGACY aliases to much older models —
# qwen-max in particular answers Turkmen prompts in near-pure Turkish.
QWEN_MODEL=qwen3.8-max
QWEN_EMBED_MODEL=text-embedding-v3

# ── Optional: DeepSeek (server-side proxy for the Kilo Code VS Code extension)
# NOTE: this is NOT required for Kilo Code to use DeepSeek — the extension
# talks to providers directly from its own settings in VS Code. This only
# matters if you specifically want /api/kilo/proxy as a server-side relay.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Optional: Kilo / OpenRouter for code-first models
# Example: https://api.kilo.ai (or your OpenRouter-compatible host)
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai
KILO_MODEL=code

# If true, the `/api/kilo/proxy` route defaults to forwarding to DeepSeek
# when no `x-target` header is provided. Set to `false` to default to Kilo.
USE_DEEPSEEK_FOR_KILO=false

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── App ─────────────────────────────────────────────────────────────────────
# Leave empty to call the Next.js routes on the same origin
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Upstash Redis (rate limiting) ───────────────────────────────────────────
# Optional in code, REQUIRED in production. Without these the limiter falls
# back to a per-process in-memory map — and because every Vercel instance is
# its own process, the ceilings become per-instance, which under any real
# concurrency means no ceiling at all. /agent/query admits guests, so an
# unconfigured limiter is an unauthenticated path to metered model calls.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Retention sweep (Vercel Cron) ───────────────────────────────────────────
# Authorises /api/cron/purge, which deletes applications past their 30-day
# purge_after deadline. Applications hold passport-level PII, so this is the
# thing that makes the retention policy real rather than advisory.
# Without it the route refuses to run — it will not sweep unauthenticated.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ── Optional: iyzico payments ───────────────────────────────────────────────
IYZIPAY_API_KEY=
IYZIPAY_SECRET_KEY=
IYZIPAY_BASE_URL=https://sandbox-api.iyzipay.com

# ── Voice calls: neural text-to-speech ──────────────────────────────────────
# Without a key the call still works and simply uses the browser's built-in
# voice, which sounds synthetic. With one, replies are spoken by a neural
# model instead.
OPENAI_API_KEY=
# Voice: alloy | ash | ballad | coral | echo | fable | nova | onyx | sage | shimmer
VOICE_TTS_VOICE=sage
VOICE_TTS_MODEL=gpt-4o-mini-tts
# Which languages use the neural voice. Drop a code to send that language back
# to the browser voice — 'tk' is the one to reconsider, since no vendor speaks
# Turkmen and it is read by a TURKISH voice via transliteration.
VOICE_TTS_LANGS=en,tr,ar,tk
